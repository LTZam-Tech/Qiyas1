       "goal": {
        "ar": "تطوير خطة استراتيجية للتحول الرقمي متوائمة مع استراتيجية الجهة ومستهدفات رؤية السعودية 2030.",
        "en": "Develop a digital transformation strategic plan aligned with the entity's strategy and the targets of Saudi Vision 2030.",
        "ur": "ڈیجیٹل تبدیلی کا ایک اسٹریٹجک منصوبہ تیار کرنا جو ادارے کی حکمتِ عملی اور سعودی ویژن 2030 کے اہداف سے ہم آہنگ ہو۔"
       },
       "requirements": [
        {
         "code": "1.1.1-R1",
         "kind": "sequential",
         "text": {
          "ar": "إعداد استراتيجية للتحول الرقمي/ للتحول للتعاملات الإلكترونية الحكومية، بحيث تشمل ما يأتي:",
          "en": "Prepare a strategy for digital transformation / the shift to e-government transactions that includes the following:"
         },
         "children": [
          {
           "code": "1.1.1-R1a",
           "text": {
            "ar": "رؤية ورسالة وركائز وأهداف استراتيجية وربطها باستراتيجية الجهة.",
            "en": "A vision, mission, pillars and strategic objectives, linked to the entity's strategy."
           }
          },
          {
           "code": "1.1.1-R1b",
           "text": {
            "ar": "المبادرات والمشاريع الاستراتيجية ومؤشرات الأداء الاستراتيجية.",
            "en": "Strategic initiatives and projects, and strategic performance indicators."
           }
          },
          {
           "code": "1.1.1-R1c",
           "text": {
            "ar": "نموذج تحقيق التكامل مع الجهات الخارجية ذات العلاقة، لتحقيق المستهدفات.",
            "en": "A model for integrating with relevant external entities to achieve the targets."
           }
          },
          {
           "code": "1.1.1-R1d",
           "text": {
            "ar": "الكفاءات والقدرات والمهارات اللازمة، لتحقيق مستهدفات الخطة.",
            "en": "The competencies, capabilities and skills needed to achieve the plan's targets."
           }
          }
         ]
        }
