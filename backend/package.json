{
  "name": "qiyas-backend",
  "version": "1.0.0",
  "description": "Digital Evidence & Compliance Management Platform - Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node -r tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node -e \"const fs=require('fs');fs.cpSync('src/compliance/db/migrations','dist/compliance/db/migrations',{recursive:true});fs.cpSync('src/compliance/framework/data','dist/compliance/framework/data',{recursive:true})\"",
    "start": "node dist/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "migrate": "node dist/scripts/migrate.js",
    "test:unit": "jest",
    "test:db": "jest -c jest.db.config.js",
    "dev:phase1": "node -e \"process.env.QIYAS_DEV_SERVER='1';require('ts-node').register({transpileOnly:true});require('tsconfig-paths/register');require('./src/compliance/dev/devServer.ts')\""
  },
  "keywords": [
    "compliance",
    "evidence-management",
    "qiyas"
  ],
  "author": "Qiyas Platform Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "bull": "^4.12.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cron": "^4.4.0",
    "csurf": "^1.11.0",
    "date-fns": "^3.0.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.5",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.7",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.11.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bull": "^4.10.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/cron": "^2.4.0",
    "@types/csurf": "^1.11.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^6.4.23",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "embedded-postgres": "^17.5.0-beta.15",
    "eslint": "^8.56.0",
    "jest": "^30.5.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
