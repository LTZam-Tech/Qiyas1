# =============================================================================
# Qiyas Platform — Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in real values:
#   cp .env.production.example .env.production
#
# NEVER commit .env.production to version control.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=qiyas_platform
POSTGRES_USER=qiyas_user
# at least 16 characters:  openssl rand -base64 48
POSTGRES_PASSWORD=

# --- Redis (password required in production, at least 16 characters) ----------
REDIS_PORT=6379
# openssl rand -base64 48
REDIS_PASSWORD=

# --- MinIO Object Storage ----------------------------------------------------
# must not be minioadmin
MINIO_ROOT_USER=qiyas-storage
# at least 16 characters:  openssl rand -base64 48
MINIO_ROOT_PASSWORD=

# --- Backend Application -----------------------------------------------------
APP_URL=http://194.163.172.141
API_PREFIX=/api/v1
CORS_ORIGIN=http://194.163.172.141

# --- JWT secret (at least 32 characters, unique; generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=
# Optional and unused (refresh tokens are opaque); if set it must meet the same rules.
JWT_REFRESH_SECRET=

# --- File Upload --------------------------------------------------------------
UPLOAD_MAX_FILE_SIZE_MB=25
UPLOAD_ALLOWED_TYPES=pdf,docx,xlsx,png,jpg,jpeg
