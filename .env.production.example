# =============================================================================
# Qiyas Platform — Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in real values:
#   cp .env.production.example .env.production
#
# NEVER commit .env.production to version control.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=qiyas_platform
POSTGRES_USER=qiyas_user
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# --- Redis (password required: docker-compose.yml refuses to start without it) -
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# --- MinIO Object Storage ----------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# --- Backend Application -----------------------------------------------------
APP_URL=http://194.163.172.141
API_PREFIX=/api/v1
CORS_ORIGIN=http://194.163.172.141

# --- JWT Secrets (generate with: openssl rand -hex 64) ------------------------
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_64

# --- File Upload --------------------------------------------------------------
UPLOAD_MAX_FILE_SIZE_MB=25
UPLOAD_ALLOWED_TYPES=pdf,docx,xlsx,png,jpg,jpeg
