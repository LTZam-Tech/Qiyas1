# Qiyas installation settings. Copy to .env and fill in every empty secret below.
# Generate each secret separately with:  openssl rand -base64 48
# The API refuses to start in production on an empty, placeholder, short (JWT under 32, datastore
# passwords under 16 characters), repetitive or reused secret, and REDIS_PASSWORD is required.
# This file holds secrets: keep it readable by the operations account only, never commit it.

QIYAS_VERSION=latest
QIYAS_HTTP_PORT=80
QIYAS_HTTPS_PORT=443

# PostgreSQL
POSTGRES_DB=qiyas
POSTGRES_USER=qiyas
# at least 16 characters:  openssl rand -base64 48
POSTGRES_PASSWORD=

# Redis
# required, at least 16 characters:  openssl rand -base64 48
REDIS_PASSWORD=

# MinIO (evidence files). The API uses the same keys; create a dedicated MinIO user for it if your policy requires.
MINIO_ROOT_USER=qiyas-storage
# at least 16 characters:  openssl rand -base64 48  (MINIO_ROOT_USER must not be minioadmin)
MINIO_ROOT_PASSWORD=
QIYAS_MINIO_BUCKET=qiyas-evidence
# QIYAS_MINIO_SSE=true          # needs a KMS configured on MinIO

# Sign-in token signing key: at least 32 characters, different from every other secret:  openssl rand -base64 48
JWT_ACCESS_SECRET=
# Optional and unused (refresh tokens are opaque). If you set it, it must meet the same rules.
JWT_REFRESH_SECRET=

# The address users type, e.g. https://qiyas.entity.gov.sa
CORS_ORIGIN=https://qiyas.entity.local

# Email through the client's relay (optional: in-app notifications always work)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=qiyas@entity.local

# Deadline scheduler: keep on for exactly one API instance
QIYAS_SCHEDULER=on

# Server that already hosts other sites on 80/443 (see README "Sharing a server with other sites"):
# COMPOSE_FILE=docker-compose.yml:docker-compose.behind-proxy.yml
# QIYAS_LOCAL_PORT=8088
